{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/concierge.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/enquiries.js": {
      "maxDuration": 15,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
